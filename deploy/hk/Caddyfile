# Config for the nuaa-guide-web container (see compose.yaml). Plain HTTP only:
# TLS is terminated by the shared yyb-peak Caddy, which proxies here (site.caddy).
{
	admin off
	auto_https off
}

:80 {
	root * /srv/current
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}

	# CSS/JS/images are referenced with content-hash ?v= query strings.
	@assets path /css/* /js/* /images/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	@pages not path /css/* /js/* /images/*
	header @pages Cache-Control "public, max-age=60, stale-while-revalidate=600"

	file_server

	handle_errors 404 {
		encode zstd gzip
		rewrite * /404.html
		file_server
	}
}
